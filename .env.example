# ─────────────────────────────────────────────────────────────
# OpenDM — environment template
# Copy to .env and fill in values.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# ── Core ────────────────────────────────────────────────────
# Public base URL of the app (used for links in emails, redirects).
APP_URL=http://localhost:3000
# Product name shown in the UI. Change this to rename the product.
APP_NAME=OpenDM
# Company / vendor name used in the footer and emails.
COMPANY_NAME=Leonyx AI
# Product this instance brands itself as. Leave empty for default.
# LOGO_URL=
# "true" enables demo mode: seeded demo workspace + simulated social
# provider. Ideal for exploring without Meta credentials.
DEMO_MODE=false

# ── Database (PostgreSQL) ───────────────────────────────────
DATABASE_URL=postgresql://leonyx:leonyx@localhost:5432/leonyx_flow?schema=public

# ── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth / secrets ──────────────────────────────────────────
# Generate with: openssl rand -base64 32
SESSION_SECRET=change-me-please-generate-a-random-32-byte-value
# AES-256 key used to encrypt provider tokens at rest. Must be 32 bytes.
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=change-me-please-generate-a-random-32-byte-value
# Access tokens must be at least this old before they are proactively
# refreshed (seconds).
TOKEN_REFRESH_THRESHOLD_SECONDS=3600

# ── Email (magic links) ─────────────────────────────────────
# Resend API key. When missing, magic links are printed to the server
# log instead of emailed — useful for local development.
RESEND_API_KEY=
EMAIL_FROM=OpenDM <no-reply@leonyx-ai.com>

# ── Meta / Instagram ────────────────────────────────────────
# Facebook App credentials (https://developers.facebook.com/apps)
META_APP_ID=
META_APP_SECRET=
# Arbitrary secret you choose; must match the value configured on the
# Instagram webhook subscription in the Meta developer dashboard.
META_VERIFY_TOKEN=change-me
META_GRAPH_VERSION=v21.0

# ── AI (optional — the product works fully without these) ───
# Set AI_PROVIDER to "anthropic", "openai", "gemini" or leave empty.
AI_PROVIDER=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# ── Queue / worker ──────────────────────────────────────────
# Prefix for BullMQ keys in Redis (isolate multiple instances).
QUEUE_PREFIX=leonyx-flow
# Worker concurrency for automation execution.
WORKER_CONCURRENCY=10
# Per-social-account outbound message rate limit:
#   max jobs flushed per RATE_LIMIT_WINDOW_MS.
RATE_LIMIT_MAX=2
RATE_LIMIT_WINDOW_MS=1000

# ── Observability ───────────────────────────────────────────
# One of: debug, info, warn, error
LOG_LEVEL=info

# ── Docker (only used by docker-compose.yml) ────────────────
POSTGRES_USER=leonyx
POSTGRES_PASSWORD=leonyx
POSTGRES_DB=leonyx_flowNEXT_PUBLIC_DEMO_MODE=true
